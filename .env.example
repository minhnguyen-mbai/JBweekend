# Server-side only. Never prefix with VITE_ — that would ship the value to the browser.

# --- Photography (Pexels) ---------------------------------------------------
# Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Weather ----------------------------------------------------------------
# The official Malaysian forecast (api.data.gov.my) needs NO key and is always on.
#
# Optional hourly provider. Leave blank to run on the official forecast alone.
# Set to "open-meteo" only if you have confirmed the licence covers your use:
# Open-Meteo's free tier is non-commercial. Enabling it is a licensing decision.
WEATHER_HOURLY_PROVIDER=
